# Copie para .env e ajuste. Em desenvolvimento, sem estas variáveis o projeto
# cai em SQLite + Celery eager (roda sem PostgreSQL/Redis).

DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (alvo do projeto) ---
# DATABASE_URL=postgres://usuario:senha@localhost:5432/sistema_arq

# --- Redis / Celery ---
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# DJANGO_REDIS_CACHE_URL=redis://localhost:6379/1

# --- Visitante ---
DJANGO_VISITANTE_TTL_HOURS=24
DJANGO_VISITANTE_RATE_LIMIT=20
DJANGO_VISITANTE_RATE_WINDOW_SECONDS=300
