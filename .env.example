# Copie para .env e ajuste. Em desenvolvimento, sem estas variáveis o projeto
# cai em SQLite + Celery eager (roda sem PostgreSQL/Redis).

DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEBUG_EXPOSE_MEDIA=true

# --- PostgreSQL (alvo do projeto) ---
# DATABASE_URL=postgres://usuario:senha@localhost:5432/sistema_arq

# --- Redis / Celery ---
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# DJANGO_REDIS_CACHE_URL=redis://localhost:6379/1

# Só ative atrás de proxy controlado que sobrescreva estes cabeçalhos.
# DJANGO_USE_X_FORWARDED_PROTO=true
# DJANGO_TRUST_X_FORWARDED_FOR=true

# --- E-mail (opcional em desenvolvimento) ---
# DJANGO_EMAIL_HOST=smtp.exemplo.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_DEFAULT_FROM_EMAIL=Sistema Arq <noreply@exemplo.com>

# Produção: use .env.production.example e DEPLOY.md.

# --- Visitante ---
DJANGO_VISITANTE_TTL_HOURS=24
DJANGO_VISITANTE_RATE_LIMIT=20
DJANGO_VISITANTE_RATE_WINDOW_SECONDS=300
