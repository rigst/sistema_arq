DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_DEBUG_EXPOSE_MEDIA=false
DJANGO_SECRET_KEY=gere-uma-chave-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=arq.exemplo.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://arq.exemplo.com
DJANGO_USE_X_FORWARDED_PROTO=true
DJANGO_TRUST_X_FORWARDED_FOR=true
DJANGO_ENABLE_CSP=true
DJANGO_DB_SSL_REQUIRE=false

POSTGRES_DB=sistema_arq
POSTGRES_USER=sistema_arq
POSTGRES_PASSWORD=troque-por-uma-senha-longa
DATABASE_URL=postgresql://sistema_arq:troque-por-uma-senha-longa@db:5432/sistema_arq

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
DJANGO_REDIS_CACHE_URL=redis://redis:6379/1

DJANGO_MEDIA_ROOT=/app/media
DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_LOG_LEVEL=INFO
GUNICORN_WORKERS=3
GUNICORN_THREADS=2

# SMTP transacional. O app já aceita estes parâmetros, mas os comandos atuais
# "Enviar ao cliente" apenas mudam o estado interno e não enviam e-mail.
DJANGO_EMAIL_HOST=smtp.exemplo.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=usuario-smtp
DJANGO_EMAIL_HOST_PASSWORD=troque-esta-senha
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_DEFAULT_FROM_EMAIL=Sistema Arq <noreply@exemplo.com>

# Opcional. Ative somente depois de validar HTTPS em todos os subdomínios.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
